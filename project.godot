; Toko Drop — Godot 4 port
; Source of truth for the browser build: https://mbace1.github.io/Suds-Jack/toko-drop/
; (source repo: mbace1/Suds-Jack, toko-drop/). Visual canon for this port: PORT_BRIEF.md.
; PORT_STATUS.md tracks what has been ported and what is still browser-only.

config_version=5

[application]

config/name="Toko Drop"
config/description="Twin-stick swarm survival. The swarm reads your gun, corpses bite back. Godot 4 port of the Three.js browser game."
run/main_scene="res://scenes/main.tscn"
; "Forward Plus" is deliberately NOT listed as a required feature: it would
; make the project unexportable to Web, which has no Vulkan. The renderer is
; chosen per platform under [rendering] instead.
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[display]

; main.gd now ports the browser's own dual ARENA_PRESETS (landscape AND
; portrait, main.js's `landscapeMode = innerWidth > innerHeight`) and picks
; between them at runtime — so this must not lock the device to one
; orientation and fight what the game itself already adapts to. A phone
; held in portrait used to get a landscape-shaped level, camera and HUD
; regardless (found 2026-08-26); "sensor" lets the real orientation through.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor"

