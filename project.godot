[rendering]

renderer/rendering_method="forward_plus"
; Browsers have no Vulkan, so the web build runs Compatibility (WebGL2). It
; loses real subsurface scattering — SSS is a Forward+ screen-space pass — so
; the gel reads flatter there. The web build exists to be PLAYED (tier
; thresholds, feel); the desktop build is what the look is judged on.
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.08, 1)
